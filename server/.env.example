# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=notifications
RABBITMQ_QUEUE=notification-worker
RABBITMQ_ROUTING_KEY=notification.#
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=5000

# Supabase Configuration (use service role key for server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pusher Configuration (optional)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=us2

# Email Configuration (optional)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Grower Platform

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=100
HEALTH_CHECK_PORT=3001

# API Server Configuration
API_PORT=3002
NOTIFICATION_API_KEY=your-secure-api-key

# Feature Flags
ENABLE_PUSHER=true
ENABLE_EMAIL=false
ENABLE_PUSH=false
ENABLE_DLQ=true

# Logging
LOG_LEVEL=info
NODE_ENV=development
